# Django Configuration
DJANGO_SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# AI Integration
GEMINI_API_KEYS=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Blockchain Configuration
BLOCKCHAIN_NETWORK=sepolia
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key
DEPLOYMENT_VALIDATOR_ADDRESS=0xYourDeployedContractAddress

# Deployment Configuration
DEPLOYMENT_BASE_PORT=9000
MAX_CONCURRENT_DEPLOYMENTS=5
DEPLOYMENT_TIMEOUT=300

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock

# Database (Optional - defaults to SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/blockchain_deployer
